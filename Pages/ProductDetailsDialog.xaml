<Window x:Class="ProductDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product details" Width="580" Height="700"
        MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Padding="24" Margin="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Image x:Name="ImgProduct" Height="210" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                    <TextBlock x:Name="TxtName" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtStatus" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,5,0,18"/>

                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <Border Background="{DynamicResource TagitSurface}" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="SELLING PRICE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="TxtPrice" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource TagitSurface}" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="QUANTITY ON HAND" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="TxtQuantity" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CATEGORY" Style="{StaticResource FilterLabel}"/>
                            <TextBlock x:Name="TxtCategory" FontSize="13" Foreground="{DynamicResource TextDark}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SKU" Style="{StaticResource FilterLabel}"/>
                            <TextBlock x:Name="TxtSku" FontSize="13" Foreground="{DynamicResource TextDark}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="COST PRICE" Style="{StaticResource FilterLabel}"/>
                            <TextBlock x:Name="TxtCostPrice" FontSize="13" Foreground="{DynamicResource TextDark}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="REORDER LEVEL" Style="{StaticResource FilterLabel}"/>
                            <TextBlock x:Name="TxtReorderLevel" FontSize="13" Foreground="{DynamicResource TextDark}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="DESCRIPTION" Style="{StaticResource FilterLabel}"/>
                        <TextBlock x:Name="TxtDescription" FontSize="13" Foreground="{DynamicResource TextDark}" TextWrapping="Wrap" LineHeight="19"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="PRODUCT OPTIONS" Style="{StaticResource FilterLabel}"/>
                        <TextBlock x:Name="TxtOptions" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="1" Content="Close" Style="{StaticResource OutlineButton}" Height="42" Width="100" HorizontalAlignment="Right" Margin="0,12,0,0" Click="BtnClose_Click"/>
        </Grid>
    </Border>
</Window>
