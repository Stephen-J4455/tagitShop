<Page x:Class="StatusCreator"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,20,32,32">
            <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Padding="24" MaxWidth="720" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="STATUS TEXT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TagitAccent}" Margin="0,0,0,18"/>
                    <TextBox x:Name="TxtStatusText" Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Style="{StaticResource LoginInput}" Margin="0,0,0,18"/>

                    <TextBlock Text="BACKGROUND COLOR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TagitAccent}" Margin="0,0,0,18"/>
                    <WrapPanel Margin="0,0,0,20">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#EC4899" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Margin="0,0,10,0" ToolTip="Pink"/>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#10B981" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Margin="0,0,10,0" ToolTip="Green"/>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#F59E0B" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Margin="0,0,10,0" ToolTip="Amber"/>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#6366F1" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Margin="0,0,10,0" ToolTip="Indigo"/>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#1E3A8A" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Margin="0,0,10,0" ToolTip="Navy"/>
                    </WrapPanel>

                    <Button Content="Post Status Update" Style="{StaticResource PrimaryButton}" Height="42" HorizontalAlignment="Left" Padding="18,8" Click="BtnPostStatus_Click"/>
                    <TextBlock x:Name="TxtFeedback" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
