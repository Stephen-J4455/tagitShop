<Page x:Class="Reviews"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource WindowBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,28,30,30">
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Product reviews" FontFamily="Georgia" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                    <TextBlock Text="Customer ratings and written feedback on your products." FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtReviewCount" Grid.Column="1" Text="0 reviews" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </Grid>
            <ItemsControl x:Name="ReviewList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource TextWhite}" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1" Padding="18" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding product_name}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TagitAccent}"/>
                                    <TextBlock Text="{Binding title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding comment}" FontSize="13" Foreground="{StaticResource TextDark}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}"><Run Text="{Binding customer_name}"/><Run Text="  /  "/><Run Text="{Binding created_at, StringFormat={}{0:MMM d, yyyy}}"/></TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="18,0,0,0">
                                    <TextBlock Text="{Binding rating, StringFormat={}{0}/5}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text=" ★" FontSize="14" Foreground="#D87954"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="TxtReviewFeedback" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>