<Page x:Class="Reviews"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,20,30,30">
            <TextBlock x:Name="TxtReviewCount" Text="0 reviews" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" Margin="0,0,0,12"/>
            <ProgressBar x:Name="LoadingIndicator" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,16" Foreground="{StaticResource TagitPrimary}" Background="{DynamicResource TagitBorder}"/>
            <Border x:Name="EmptyReviewsState" Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Padding="26" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource TagitAccent}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtEmptyReviewsTitle" Text="No reviews yet" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}" HorizontalAlignment="Center" Margin="0,9,0,0"/>
                    <TextBlock x:Name="TxtEmptyReviewsMessage" Text="Customer feedback on your products will appear here." FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <ItemsControl x:Name="ReviewList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Padding="18" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding product_name}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TagitAccent}"/>
                                    <TextBlock Text="{Binding title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding comment}" FontSize="13" Foreground="{DynamicResource TextDark}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}"><Run Text="{Binding customer_name}"/><Run Text="  /  "/><Run Text="{Binding created_at, StringFormat={}{0:MMM d, yyyy}}"/></TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="18,0,0,0">
                                    <TextBlock Text="{Binding rating, StringFormat={}{0}/5}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                                    <TextBlock Text=" ★" FontSize="14" Foreground="#D87954"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="TxtReviewFeedback" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>