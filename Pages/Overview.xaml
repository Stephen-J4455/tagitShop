<Page x:Class="Overview"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource WindowBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,28,30,30">
            <Grid Margin="0,0,0,21">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Overview" FontFamily="Georgia" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                    <TextBlock Text="Today at a glance: paid sales, available stock and items to replenish." FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtOverviewDate" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Background="{StaticResource TextWhite}" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1" Padding="16" Margin="0,0,9,0"><StackPanel><TextBlock Text="PAID SALES TODAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="TxtTotalSales" Text="GHC 0" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Background="{StaticResource TextWhite}" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1" Padding="16" Margin="0,0,9,0"><StackPanel><TextBlock Text="PAID ORDERS TODAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="TxtTotalOrders" Text="0" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Background="{StaticResource TextWhite}" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1" Padding="16" Margin="0,0,9,0"><StackPanel><TextBlock Text="PRODUCTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="TxtTotalProducts" Text="0" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Background="#E9EFD1" BorderBrush="#D6E0B2" BorderThickness="1" Padding="16"><StackPanel><TextBlock Text="REORDER REQUIRED" FontSize="10" FontWeight="Bold" Foreground="#56612B"/><TextBlock x:Name="TxtLowStock" Text="0 items" FontSize="23" FontWeight="Bold" Foreground="#56612B" Margin="0,5,0,0"/></StackPanel></Border>
            </UniformGrid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource TextWhite}" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1" Padding="18">
                    <StackPanel><TextBlock Text="Paid sales / last 7 days" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/><TextBlock Text="Revenue by payment date, GHC" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/><Canvas x:Name="SalesChartCanvas" Height="220" Margin="0,12,0,0" SizeChanged="SalesChartCanvas_SizeChanged"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource TextWhite}" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1" Padding="18">
                    <StackPanel><TextBlock Text="Reorder list" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/><TextBlock Text="At or below your reorder level" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,10"/>
                        <ItemsControl x:Name="LowStockGrid"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource TagitBorder}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding sku}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding quantity, StringFormat={}{0} left}" FontSize="11" FontWeight="Bold" Foreground="#9A5739" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock x:Name="TxtNoLowStock" Text="All tracked items are above reorder level." FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Store actions" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
            <UniformGrid Columns="3" Margin="0,0,0,22">
                <Button Content="Start stocktake" Style="{StaticResource OutlineButton}" Height="42" Margin="0,0,9,0" Click="BtnStocktake_Click"/>
                <Button Content="Manage products" Style="{StaticResource OutlineButton}" Height="42" Margin="0,0,9,0" Click="BtnCatalog_Click"/>
                <Button Content="View sales" Style="{StaticResource OutlineButton}" Height="42" Click="BtnOrders_Click"/>
            </UniformGrid>

            <TextBlock Text="Recent paid sales" Style="{StaticResource SectionHeader}" Margin="0,0,0,9"/>
            <ItemsControl x:Name="RecentSalesGrid"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="{StaticResource TextWhite}" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1" Padding="13" Margin="0,0,0,7">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding order_number}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/><TextBlock Text="{Binding customer_name}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/></StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding total, StringFormat=GHC {0:N2}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center" Margin="10,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding paid_at, StringFormat={}{0:MMM d, h:mm tt}}" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock x:Name="TxtOverviewFeedback" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>