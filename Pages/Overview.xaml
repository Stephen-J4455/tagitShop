<Page x:Class="Overview"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,30">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Overview" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}"/>
                    <TextBlock x:Name="TxtOverviewDate" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Products" Style="{StaticResource OutlineButton}" Height="38" Padding="16,8" Margin="0,0,8,0" Click="BtnCatalog_Click"/>
                    <Button Content="View sales" Style="{StaticResource PrimaryButton}" Height="38" Padding="16,8" Click="BtnOrders_Click"/>
                </StackPanel>
            </Grid>
            <ProgressBar x:Name="LoadingIndicator" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,16" Foreground="{StaticResource TagitPrimary}" Background="{DynamicResource TagitBorder}"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.95*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.35*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#242424" CornerRadius="16" Padding="22" MinHeight="230">
                    <StackPanel>
                        <TextBlock x:Name="TxtPrimaryMetricLabel" Text="Paid sales, last 7 days" FontSize="14" FontWeight="SemiBold" Foreground="#E8E8E8"/>
                        <TextBlock x:Name="TxtTotalSales" Text="GHC 0.00" FontSize="31" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,18"/>
                        <Border Height="1" Background="#494949" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Paid orders" FontSize="10" Foreground="#BDBDBD"/>
                                <TextBlock x:Name="TxtTotalOrders" Text="0" FontSize="19" FontWeight="SemiBold" Foreground="White" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Products" FontSize="10" Foreground="#BDBDBD"/>
                                <TextBlock x:Name="TxtTotalProducts" Text="0" FontSize="19" FontWeight="SemiBold" Foreground="White" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="Restock" FontSize="10" Foreground="#BDBDBD"/>
                                <TextBlock x:Name="TxtLowStock" Text="0 items" FontSize="19" FontWeight="SemiBold" Foreground="White" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20" MinHeight="230">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sales trend" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}"/>
                                <TextBlock x:Name="TxtSalesChartSubtitle" Text="Paid sales for the last 12 months" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbOverviewRange" Grid.Column="1" Width="150" Height="36" SelectedIndex="0" SelectionChanged="CmbOverviewRange_SelectionChanged" Foreground="{DynamicResource TextDark}" BorderBrush="{DynamicResource TagitBorder}" Background="{DynamicResource InputSurface}">
                                <ComboBoxItem Content="Last 12 months" Tag="Monthly"/>
                                <ComboBoxItem Content="Last 7 days" Tag="Weekly"/>
                                <ComboBoxItem Content="This month" Tag="CurrentMonth"/>
                                <ComboBoxItem Content="Last 6 months" Tag="SixMonths"/>
                                <ComboBoxItem Content="This year" Tag="CurrentYear"/>
                            </ComboBox>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource TagitAccent}" VerticalAlignment="Center"/>
                            <TextBlock Text="Revenue" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="5,0,14,0"/>
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource TagitDark}" VerticalAlignment="Center"/>
                            <TextBlock Text="Gross profit" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="5,0,0,0"/>
                        </StackPanel>
                        <Canvas x:Name="SalesChartCanvas" Height="150" Margin="0,8,0,0" SizeChanged="SalesChartCanvas_SizeChanged"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.45*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20" MinHeight="174">
                    <StackPanel>
                        <TextBlock Text="Average paid order" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}"/>
                        <TextBlock x:Name="TxtAverageOrderCaption" Text="Across the last 7 days" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,12"/>
                        <TextBlock x:Name="TxtAverageOrderValue" Text="GHC 0.00" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}"/>
                        <TextBlock x:Name="TxtAverageOrderCount" Text="0 paid orders" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20" MinHeight="174">
                    <StackPanel>
                        <TextBlock Text="Restock list" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}"/>
                        <TextBlock Text="Products at or below reorder level" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,8"/>
                        <ItemsControl x:Name="LowStockGrid">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource TagitBorder}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding sku}" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding quantity, StringFormat={}{0} left}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtNoLowStock" Text="Everything is above its reorder level." FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Recent paid sales" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}"/>
                    <TextBlock Text="The latest completed payments in your store." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,12"/>
                </StackPanel>
                <Button Grid.Column="1" Content="View all sales" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Click="BtnOrders_Click"/>
            </Grid>
            <Border x:Name="EmptyRecentSalesState" Style="{StaticResource Card}" Padding="22" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="No paid sales yet" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Completed payments will appear here." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border x:Name="RecentSalesGridContainer" Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" CornerRadius="12" Padding="8">
                <DataGrid x:Name="RecentSalesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="38" ColumnHeaderHeight="34" Background="{DynamicResource CardSurface}" AlternatingRowBackground="{DynamicResource DataGridAltSurface}" Foreground="{DynamicResource TextDark}" HorizontalGridLinesBrush="{DynamicResource TagitBorder}" VerticalGridLinesBrush="Transparent">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource TableHeaderSurface}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource TagitBorder}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ORDER" Binding="{Binding order_number}" Width="*"/>
                        <DataGridTextColumn Header="CUSTOMER" Binding="{Binding customer_name}" Width="*"/>
                        <DataGridTextColumn Header="TOTAL (GHC)" Binding="{Binding total, StringFormat=N2}" Width="*"/>
                        <DataGridTextColumn Header="PAID AT" Binding="{Binding paid_at, StringFormat={}{0:MMM d, h:mm tt}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <TextBlock x:Name="TxtOverviewFeedback" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,14,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>