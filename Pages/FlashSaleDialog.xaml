<Window x:Class="FlashSaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Flash Sale" Width="500" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" ResizeMode="NoResize">
    <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Padding="28" Margin="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Create Flash Sale" FontFamily="Georgia" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                    <TextBlock Text="Set a limited-time discount on a product." FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,22"/>

                    <TextBlock Text="PRODUCT" Style="{StaticResource FilterLabel}"/>
                    <Button x:Name="BtnChooseProduct" Content="Choose a product" Style="{StaticResource OutlineButton}" Height="44" HorizontalContentAlignment="Left" Padding="12,0" IsEnabled="False" Click="BtnChooseProduct_Click"/>
                    <Border x:Name="SelectedProductPanel" Background="{DynamicResource TagitSurface}" CornerRadius="10" Padding="12" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSelectedProductName" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtProductStatus" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Change" Style="{StaticResource GhostButton}" Padding="10,5" Click="BtnChooseProduct_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TxtProductAvailability" Text="Choose from your active catalog." FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,5,0,12"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="FLASH PRICE (GHC)" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtFlashPrice" Style="{StaticResource LoginInput}" Tag="0.00"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="ORIGINAL PRICE (GHC)" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtOriginalPrice" Style="{StaticResource LoginInput}" IsReadOnly="True" Tag="Choose a product"/></StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="START TIME" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtStartTime" Style="{StaticResource LoginInput}" Tag="2026-11-07T10:00:00"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="END TIME" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtEndTime" Style="{StaticResource LoginInput}" Tag="2026-11-08T10:00:00"/></StackPanel>
                    </Grid>

                    <TextBlock Text="MAX QUANTITY (optional)" Style="{StaticResource FilterLabel}"/>
                    <TextBox x:Name="TxtMaxQuantity" Style="{StaticResource LoginInput}" Tag="Leave blank for no limit" Margin="0,0,0,8"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancel" Style="{StaticResource OutlineButton}" Height="44" HorizontalAlignment="Stretch" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnSave" Grid.Column="2" Content="Create Flash Sale" Style="{StaticResource PrimaryButton}" Height="44" HorizontalAlignment="Stretch" IsEnabled="False" Click="BtnSave_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
