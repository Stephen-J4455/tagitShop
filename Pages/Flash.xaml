<Page x:Class="Flash"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:tagitShop"
      mc:Ignorable="d"
      Background="{StaticResource WindowBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,32,32,32">

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Flash Sales" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                    <TextBlock Text="Limited-time promotions and discounts" FontSize="14" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="+ Create Flash Sale" Style="{StaticResource PrimaryButton}" Click="BtnCreateFlash_Click"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Active Flash Sales" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
            <ItemsControl x:Name="FlashGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource TextWhite}" CornerRadius="12" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1" Width="260" Margin="0,0,16,16" Padding="16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TagitPrimary}">
                                        <Run Text="{Binding discount}"/><Run Text="% OFF"/>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="{Binding description}" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                <Border Height="100" Background="{StaticResource TagitSurface}" CornerRadius="8" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding product}" FontSize="13" Foreground="{StaticResource TextDark}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Ends {Binding endTime}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <ProgressBar Value="{Binding progress}" Height="6" Margin="0,8,0,0" Foreground="{StaticResource TagitPrimary}" Background="{StaticResource TagitBorder}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,16,0,0"/>

        </StackPanel>
    </ScrollViewer>
</Page>
