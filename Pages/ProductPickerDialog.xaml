<Window x:Class="ProductPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a product" Width="520" Height="590"
        MinWidth="420" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Padding="22" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Choose a product" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}"/>
                <TextBlock Text="Select an active product for this flash sale." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,5,0,0"/>
            </StackPanel>

            <TextBox x:Name="TxtSearch" Grid.Row="1" Style="{StaticResource LoginInput}" Tag="Search products" Margin="0,0,0,12"/>

            <ListBox x:Name="ProductsList" Grid.Row="2" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Background="{DynamicResource CardSurface}" SelectionMode="Single" MouseDoubleClick="ProductsList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource TagitBorder}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SidebarItemActive}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding sku, TargetNullValue='No SKU'}" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="GHC " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Text="{Binding price, StringFormat={}{0:N2}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtResultCount" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource OutlineButton}" Height="40" Width="95" Click="BtnCancel_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSelect" Content="Select product" Style="{StaticResource PrimaryButton}" Height="40" Width="120" IsEnabled="False" Click="BtnSelect_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
