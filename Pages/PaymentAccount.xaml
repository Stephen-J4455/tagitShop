<Page x:Class="PaymentAccount"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:tagitShop"
      mc:Ignorable="d"
     
      Background="{StaticResource WindowBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,32,32,32" HorizontalAlignment="Center" VerticalAlignment="Top">

            <Border Background="{StaticResource TextWhite}" CornerRadius="12" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1" Padding="32" Width="400">
                <StackPanel>
                    <TextBlock Text="Payment Account" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <TextBlock Text="Bank Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtBankName" Height="44" Style="{StaticResource LoginInput}" Tag="Bank name"/>

                    <TextBlock Text="Account Number" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,16,0,6"/>
                    <TextBox x:Name="TxtAccountNumber" Height="44" Style="{StaticResource LoginInput}" Tag="Account number"/>

                    <TextBlock Text="Account Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,16,0,6"/>
                    <TextBox x:Name="TxtAccountName" Height="44" Style="{StaticResource LoginInput}" Tag="Account name"/>

                    <Button Content="Save Payment Details" Style="{StaticResource PrimaryButton}" Height="44" Click="BtnSave_Click" Margin="0,24,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>