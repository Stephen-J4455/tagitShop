<Window x:Class="AddProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product details" Width="500" Height="710"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}" ResizeMode="CanResizeWithGrip">
    <Border Background="{StaticResource TextWhite}" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1" Padding="28" Margin="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="TxtDialogTitle" Text="Add product" FontFamily="Georgia" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                <TextBlock Text="Product identity, pricing and shelf quantity" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,5,0,22"/>

                <TextBlock Text="PRODUCT NAME" Style="{StaticResource FilterLabel}"/>
                <TextBox x:Name="TxtProductName" Style="{StaticResource LoginInput}" Tag="e.g. Fresh Organic Apples" Margin="0,0,0,14"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="SKU" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtSku" Style="{StaticResource LoginInput}" Tag="PRD-1001"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="BARCODE" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtBarcode" Style="{StaticResource LoginInput}" Tag="Optional"/></StackPanel>
                </Grid>
                <TextBlock Text="CATEGORY" Style="{StaticResource FilterLabel}"/>
                <ComboBox x:Name="CmbCategory" Height="42" Margin="0,0,0,14" Foreground="{StaticResource TextDark}" BorderBrush="{StaticResource TagitBorder}" Background="White">
                    <ComboBoxItem Content="Produce"/><ComboBoxItem Content="Bakery"/><ComboBoxItem Content="Dairy"/><ComboBoxItem Content="Beverages"/><ComboBoxItem Content="Snacks"/><ComboBoxItem Content="Household"/><ComboBoxItem Content="Other"/>
                </ComboBox>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="COST PRICE (GHC)" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtCostPrice" Style="{StaticResource LoginInput}" Tag="0.00"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="SELLING PRICE (GHC)" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtPrice" Style="{StaticResource LoginInput}" Tag="0.00"/></StackPanel>
                </Grid>
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="ON-HAND QUANTITY" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtQuantity" Style="{StaticResource LoginInput}" Tag="0"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="REORDER LEVEL" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtReorderLevel" Style="{StaticResource LoginInput}" Tag="0"/></StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource OutlineButton}" Height="42" Width="100" Click="BtnCancel_Click" Margin="0,0,10,0"/>
                    <Button x:Name="BtnSave" Content="Save product" Style="{StaticResource PrimaryButton}" Height="42" Width="140" Click="BtnAdd_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>