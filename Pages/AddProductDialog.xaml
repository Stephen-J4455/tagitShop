<Window x:Class="AddProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product details" Width="760" Height="790" MinWidth="660" MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" ResizeMode="CanResizeWithGrip">
    <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Padding="24" Margin="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TxtDialogTitle" Text="New Product" FontFamily="Georgia" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                    <TextBlock x:Name="TxtStepCaption" Text="Media - Step 1 of 4" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Cancel" Style="{StaticResource OutlineButton}" Height="38" Padding="14,6" VerticalAlignment="Top" Click="BtnCancel_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <UniformGrid Columns="4" Margin="0,0,0,7">
                    <TextBlock x:Name="LblMediaStep" Text="1  MEDIA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TagitPrimary}"/>
                    <TextBlock x:Name="LblBasicsStep" Text="2  BASICS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock x:Name="LblInventoryStep" Text="3  INVENTORY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock x:Name="LblDetailsStep" Text="4  DETAILS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                </UniformGrid>
                <ProgressBar x:Name="FormProgress" Minimum="0" Maximum="4" Value="1" Height="4" Foreground="{StaticResource TagitPrimary}" Background="{DynamicResource TagitBorder}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel x:Name="MediaStepPanel">
                        <TextBlock Text="Product photos" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}"/>
                        <TextBlock Text="Add at least one photo. The first photo is used as the cover image; up to five photos are supported." FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                        <WrapPanel x:Name="ImagePreviewPanel" Margin="-6,0,0,12"/>
                        <Button Content="Add photos" Style="{StaticResource OutlineButton}" Width="130" Height="40" HorizontalAlignment="Left" Click="BtnAddPhotos_Click"/>
                        <TextBlock x:Name="TxtPhotoCount" Text="0 / 5 photos" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0"/>
                        <Border Background="{DynamicResource TagitSurface}" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Padding="14" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="AUTO-CREATE DETAILS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                <TextBlock Text="Optional price and quantity hints" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtAgentPriceHint" Grid.Column="0" Style="{StaticResource LoginInput}" Tag="Price hint (GHC)"/>
                                    <TextBox x:Name="TxtAgentQuantityHint" Grid.Column="2" Style="{StaticResource LoginInput}" Tag="Quantity hint"/>
                                </Grid>
                                <Button x:Name="BtnAutoCreate" Content="Auto-create from photo" Style="{StaticResource OutlineButton}" Width="190" Height="38" HorizontalAlignment="Left" Click="BtnAutoCreate_Click"/>
                                <ProgressBar x:Name="AutoCreateProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0" Foreground="{StaticResource TagitPrimary}" Background="{DynamicResource TagitBorder}"/>
                                <TextBlock x:Name="TxtAutoCreateStatus" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Padding="14" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="PRODUCT VIDEO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                <TextBlock Text="Optional video, maximum 30 MB" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Add video" Style="{StaticResource OutlineButton}" Width="110" Height="38" Click="BtnPickVideo_Click"/>
                                    <Button x:Name="BtnRemoveVideo" Style="{StaticResource OutlineButton}" Width="38" Height="38" Margin="8,0,0,0" Click="BtnRemoveVideo_Click" Visibility="Collapsed" ToolTip="Remove video">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="TxtVideoStatus" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="BasicsStepPanel" Visibility="Collapsed">
                        <TextBlock Text="Product info" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,14"/>
                        <TextBlock Text="TITLE *" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="TxtProductName" Style="{StaticResource LoginInput}" Tag="e.g. Ankara two-piece set" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="PRICE (GHC) *" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtPrice" Style="{StaticResource LoginInput}" Tag="0.00"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="SHIPPING (GHC)" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtShippingFee" Style="{StaticResource LoginInput}" Tag="0.00"/></StackPanel>
                        </Grid>
                        <TextBlock Text="CATEGORY *" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="CmbCategory" Height="42" Margin="0,0,0,14" Foreground="{DynamicResource TextDark}" BorderBrush="{DynamicResource TagitBorder}" Background="{DynamicResource InputSurface}" DisplayMemberPath="Name"/>
                        <ProgressBar x:Name="CategoryLoadingIndicator" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,-10,0,12" Foreground="{StaticResource TagitPrimary}" Background="{DynamicResource TagitBorder}"/>
                        <TextBlock Text="DESCRIPTION" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="TxtDescription" Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Style="{StaticResource LoginInput}" Tag="Describe materials, fit, care instructions..."/>
                    </StackPanel>

                    <StackPanel x:Name="InventoryStepPanel" Visibility="Collapsed">
                        <TextBlock Text="Stock &amp; pricing" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="QUANTITY *" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtQuantity" Style="{StaticResource LoginInput}" Tag="0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="DISCOUNT %" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtDiscount" Style="{StaticResource LoginInput}" Tag="0"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="COMPARE-AT PRICE (GHC)" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtCompareAtPrice" Style="{StaticResource LoginInput}" Tag="Optional"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="COST PER ITEM (GHC)" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtCostPrice" Style="{StaticResource LoginInput}" Tag="Optional"/></StackPanel>
                        </Grid>
                        <TextBlock Text="SIZES" Style="{StaticResource FilterLabel}"/>
                        <WrapPanel x:Name="SizesPanel" Margin="0,0,0,14"/>
                        <TextBlock Text="COLORS" Style="{StaticResource FilterLabel}"/>
                        <WrapPanel x:Name="ColorsPanel" Margin="0,0,0,14"/>
                        <CheckBox x:Name="ChkPreorder" Content="Preorder" Foreground="{DynamicResource TextDark}" Margin="0,4"/>
                        <CheckBox x:Name="ChkTrackInventory" Content="Track inventory" IsChecked="True" Foreground="{DynamicResource TextDark}" Margin="0,4"/>
                        <CheckBox x:Name="ChkAllowBackorder" Content="Allow backorder" Foreground="{DynamicResource TextDark}" Margin="0,4"/>
                    </StackPanel>

                    <StackPanel x:Name="DetailsStepPanel" Visibility="Collapsed">
                        <TextBlock Text="Specifications" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,10"/>
                        <StackPanel x:Name="SpecificationsPanel"/>
                        <Button Content="Add specification" Style="{StaticResource OutlineButton}" Width="160" Height="36" HorizontalAlignment="Left" Margin="0,0,0,16" Click="BtnAddSpecification_Click"/>
                        <TextBlock Text="TAGS" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="TxtTags" Style="{StaticResource LoginInput}" Tag="Comma-separated, up to 10" Margin="0,0,0,16"/>
                        <TextBlock Text="ORGANIZATION" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="SKU" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtSku" Style="{StaticResource LoginInput}" Tag="Optional"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="BARCODE" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtBarcode" Style="{StaticResource LoginInput}" Tag="Optional"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="VENDOR" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtVendor" Style="{StaticResource LoginInput}" Tag="Optional"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="WEIGHT" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtWeight" Style="{StaticResource LoginInput}" Tag="Optional"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="UNIT" Style="{StaticResource FilterLabel}"/><ComboBox x:Name="CmbWeightUnit" Height="42" Width="82" SelectedIndex="0"><ComboBoxItem Content="kg"/><ComboBoxItem Content="g"/><ComboBoxItem Content="lb"/><ComboBoxItem Content="oz"/></ComboBox></StackPanel>
                        </Grid>
                        <Border Background="{DynamicResource TagitSurface}" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <TextBlock Text="REVIEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtReviewTitle" Text="Product title" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}"/>
                                <TextBlock x:Name="TxtReviewPrice" Text="GHC 0.00" FontSize="13" Foreground="{DynamicResource TextDark}" Margin="0,3,0,0"/>
                                <TextBlock x:Name="TxtReviewStock" Text="Stock: 0" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                                <TextBlock x:Name="TxtReviewMedia" Text="0 photos" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="3" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="BtnBack" Grid.Column="0" Content="Back" Style="{StaticResource OutlineButton}" Height="42" Width="100" Click="BtnBack_Click" Visibility="Collapsed"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                        <TextBlock x:Name="TxtSaveProgress" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="OperationProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,5,0,0" Foreground="{StaticResource TagitPrimary}" Background="{DynamicResource TagitBorder}"/>
                    </StackPanel>
                    <Button x:Name="BtnContinue" Grid.Column="2" Content="Continue" Style="{StaticResource PrimaryButton}" Height="42" Width="140" Click="BtnContinue_Click"/>
                    <Button x:Name="BtnPublish" Grid.Column="2" Content="Publish product" Style="{StaticResource PrimaryButton}" Height="42" Padding="16,8" Click="BtnPublish_Click" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>