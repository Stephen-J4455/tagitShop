<Page x:Class="Orders"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:tagitShop"
      mc:Ignorable="d"
     
      Background="{StaticResource WindowBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,32,32,32">

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Sales ledger" FontFamily="Georgia" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                    <TextBlock Text="Payment and order records for this store." FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Refresh" Style="{StaticResource OutlineButton}" Height="38" Click="BtnRefresh_Click"/>
                </StackPanel>
            </Grid>

            <UniformGrid Columns="3" Margin="0,0,0,24">
                <Border Background="{StaticResource TextWhite}" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1" Padding="17" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="TOTAL PAID SALES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="TxtTotalSales" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Background="{StaticResource TextWhite}" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1" Padding="17" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="TOTAL SALES VALUE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="TxtTotalRevenue" Text="GHC 0.00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Background="#E9EFD1" BorderBrush="#D6E0B2" BorderThickness="1" Padding="17">
                    <StackPanel><TextBlock Text="CUSTOMERS" FontSize="10" FontWeight="Bold" Foreground="#56612B"/><TextBlock x:Name="TxtCustomerCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="#56612B" Margin="0,4,0,0"/></StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Latest records" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
            <ItemsControl x:Name="OrderGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ProductCard}" Width="Auto" MaxWidth="700" Margin="0,0,0,12" Padding="0">
                            <StackPanel Margin="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding order_number}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding customer_name}" FontSize="13" Foreground="{StaticResource TextDark}" Margin="16,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding status}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TagitPrimary}" Margin="16,0,0,0"/>
                                    <TextBlock Grid.Column="3" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="16,0,0,0">
                                        <Run Text="GHC "/><Run Text="{Binding total, StringFormat=N2}"/>
                                    </TextBlock>
                                </Grid>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0">
                                    <Run Text="{Binding items}"/><Run Text=" items • "/><Run Text="{Binding created_at}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,16,0,0"/>

        </StackPanel>
    </ScrollViewer>
</Page>