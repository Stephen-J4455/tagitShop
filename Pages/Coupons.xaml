<Page x:Class="Coupons"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:tagitShop"
      mc:Ignorable="d"
      Background="{DynamicResource WindowBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,20,32,32">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                <Button Content="+ Create Coupon" Style="{StaticResource PrimaryButton}" Click="BtnCreateCoupon_Click"/>
            </StackPanel>
            <ProgressBar x:Name="LoadingIndicator" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,16" Foreground="{StaticResource TagitPrimary}" Background="{DynamicResource TagitBorder}"/>

            <TextBlock Text="Your Coupons" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
            <Border x:Name="EmptyCouponsState" Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Padding="26" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource TagitPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No coupons yet" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}" HorizontalAlignment="Center" Margin="0,9,0,0"/>
                    <TextBlock Text="Create a coupon to offer discounts to your customers." FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <ItemsControl x:Name="CouponGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardSurface}" CornerRadius="12" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Width="260" Margin="0,0,16,16" Padding="16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding code}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TagitPrimary}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding status}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TagitAccent}"/>
                                </Grid>
                                <TextBlock Text="{Binding description}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}">
                                    <Run Text="{Binding discount}"/><Run Text="% OFF"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0">
                                    <Run Text="{Binding uses}"/><Run Text=" uses"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,16,0,0"/>

        </StackPanel>
    </ScrollViewer>
</Page>
