<Page x:Class="Reels"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:tagitShop"
      mc:Ignorable="d"
      Background="{DynamicResource WindowBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,20,32,32">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                <Button Content="+ Upload Reel" Style="{StaticResource PrimaryButton}" Click="BtnUploadReel_Click"/>
            </StackPanel>
            <ProgressBar x:Name="LoadingIndicator" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,16" Foreground="{StaticResource TagitPrimary}" Background="{DynamicResource TagitBorder}"/>

            <TextBlock Text="Your Reels" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
            <Border x:Name="EmptyReelsState" Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Padding="26" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource TagitPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No reels yet" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}" HorizontalAlignment="Center" Margin="0,9,0,0"/>
                    <TextBlock Text="Upload a short video reel to showcase your products." FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <ItemsControl x:Name="ReelsGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardSurface}" CornerRadius="12" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Width="260" Margin="0,0,16,16">
                            <StackPanel>
                                <Border Height="180" Background="{DynamicResource TagitSurface}" CornerRadius="8" Margin="0,0,0,8">
                                    <Grid>
                                        <MediaElement x:Name="ReelMedia" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill" Width="240" Height="180" Visibility="Collapsed" MediaOpened="ReelMedia_MediaOpened" MediaFailed="ReelMedia_MediaFailed" MouseLeftButtonDown="ReelMedia_MouseLeftButtonDown"/>
                                        <Image x:Name="ReelThumbnail" Source="{Binding thumbnail_url}" Stretch="UniformToFill" Width="240" Height="180"/>
                                        <Border Background="#40000000" CornerRadius="8" Visibility="{Binding ElementName=ReelThumbnail, Path=Visibility}">
                                            <TextBlock Text="{Binding title}" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="200"/>
                                        </Border>
                                        <Button x:Name="BtnPlayReel" Content="▶" FontSize="24" Foreground="White" Background="#80000000" BorderThickness="0" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Click="BtnPlayReel_Click" ToolTip="Play video">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="30">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}">
                                    <Run Text="{Binding views}"/><Run Text=" views"/>
                                </TextBlock>
                                <TextBlock Text="{Binding time}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <Button Content="Delete" Tag="{Binding}" Style="{StaticResource OutlineButton}" Foreground="{StaticResource ErrorColor}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="9,5" Click="BtnDeleteReel_Click"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,16,0,0"/>

        </StackPanel>
    </ScrollViewer>
</Page>
