<Page x:Class="Stocktake"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource WindowBackground}">
    <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="PageScrollViewer_PreviewMouseWheel">
        <StackPanel Margin="30,28,30,30">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Stocktake" FontFamily="Georgia" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                    <TextBlock Text="Count what is on the shelf, review the variance, then apply the adjustment." FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Apply count" Style="{StaticResource PrimaryButton}" Height="40" Padding="18,8" VerticalAlignment="Center" Click="BtnApplyCount_Click"/>
            </Grid>

            <Border Background="#E9EFD1" BorderBrush="#D6E0B2" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Enter the physical count for each item. Variance is calculated against current system quantity." FontSize="12" Foreground="#43502B" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtLastCount" Grid.Column="1" Text="No previous count" FontSize="11" FontWeight="SemiBold" Foreground="#56612B" VerticalAlignment="Center" Margin="18,0,0,0"/>
                </Grid>
            </Border>

            <Border Background="{StaticResource TextWhite}" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1">
                <DataGrid x:Name="StocktakeGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="54" ColumnHeaderHeight="38" Background="White" Foreground="{StaticResource TextDark}" HorizontalGridLinesBrush="{StaticResource TagitBorder}" VerticalGridLinesBrush="Transparent">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="IMAGE" Width="62" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><Image Source="{Binding Product.image}" Width="38" Height="38" Stretch="UniformToFill"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PRODUCT" Binding="{Binding Product.title}" Width="2*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Product.sku}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="SYSTEM QTY" Binding="{Binding ExpectedQuantity}" Width="*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="COUNTED" Width="*">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding CountedQuantity, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1" Padding="7,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="VARIANCE" Binding="{Binding Variance}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="VALUE CHANGE" Binding="{Binding ValueVariance, StringFormat=N2}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <TextBlock x:Name="TxtCountFeedback" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="RECENT COUNTS ON THIS COMPUTER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,24,0,9"/>
            <ItemsControl x:Name="StocktakeHistory">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource TextWhite}" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1" Padding="13" Margin="0,0,0,7">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding counted_at, StringFormat={}{0:MMM d, yyyy h:mm tt}}" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ItemCount, StringFormat={}{0} items}" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="20,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding VarianceCount, StringFormat={}{0} adjustments}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>