<Page x:Class="Catalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource WindowBackground}">
    <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="PageScrollViewer_PreviewMouseWheel">
        <StackPanel Margin="30,28,30,30">
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Products &amp; pricing" FontFamily="Georgia" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                    <TextBlock Text="Keep item costs, shelf prices and quantities current." FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="TxtSearch" Width="220" Height="38" Style="{StaticResource LoginInput}" Tag="Search name or SKU" TextChanged="TxtSearch_TextChanged" Margin="0,0,10,0"/>
                    <Button Content="Add product" Style="{StaticResource PrimaryButton}" Height="38" Click="BtnAddProduct_Click"/>
                </StackPanel>
            </Grid>

            <UniformGrid Columns="3" Margin="0,0,0,20">
                <Border Background="{StaticResource TextWhite}" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1" Padding="17" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="PRODUCTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="TxtProductCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Background="{StaticResource TextWhite}" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1" Padding="17" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="RETAIL STOCK VALUE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="TxtStockValue" Text="GHC 0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Background="#F1F4D8" BorderBrush="#D8E2A2" BorderThickness="1" Padding="17">
                    <StackPanel><TextBlock Text="AT / BELOW REORDER LEVEL" FontSize="10" FontWeight="Bold" Foreground="#56612B"/><TextBlock x:Name="TxtLowStock" Text="0 items" FontSize="24" FontWeight="Bold" Foreground="#56612B" Margin="0,4,0,0"/></StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="{StaticResource TextWhite}" BorderBrush="{StaticResource TagitBorder}" BorderThickness="1">
                <DataGrid x:Name="ProductGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="54" ColumnHeaderHeight="38" Background="White" Foreground="{StaticResource TextDark}" HorizontalGridLinesBrush="{StaticResource TagitBorder}" VerticalGridLinesBrush="Transparent" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="PRODUCT" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{Binding image}" Width="40" Height="40" Stretch="UniformToFill" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="SKU" Binding="{Binding sku}" Width="*"/>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding category}" Width="*"/>
                        <DataGridTextColumn Header="COST" Binding="{Binding cost_price, StringFormat=N2}" Width="*"/>
                        <DataGridTextColumn Header="SELLING PRICE" Binding="{Binding price, StringFormat=N2}" Width="*"/>
                        <DataGridTextColumn Header="ON HAND" Binding="{Binding quantity}" Width="*"/>
                        <DataGridTextColumn Header="REORDER AT" Binding="{Binding reorder_level}" Width="*"/>
                        <DataGridTemplateColumn Header="" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><Button Content="Edit" Tag="{Binding}" Style="{StaticResource OutlineButton}" Padding="8,4" Click="BtnEditProduct_Click"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <TextBlock x:Name="TxtPageFeedback" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>