<Window x:Class="CouponDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Coupon" Width="500" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" ResizeMode="NoResize">
    <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource TagitBorder}" BorderThickness="1" Padding="28" Margin="18">
        <StackPanel>
            <TextBlock Text="Create Coupon" FontFamily="Georgia" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
            <TextBlock Text="Set a discount code for your customers." FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,22"/>

            <TextBlock Text="COUPON CODE" Style="{StaticResource FilterLabel}"/>
            <TextBox x:Name="TxtCode" Style="{StaticResource LoginInput}" Tag="WELCOME20" Margin="0,0,0,14"/>

            <TextBlock Text="DESCRIPTION" Style="{StaticResource FilterLabel}"/>
            <TextBox x:Name="TxtDescription" Style="{StaticResource LoginInput}" Tag="e.g. 20% off first order" Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="DISCOUNT TYPE" Style="{StaticResource FilterLabel}"/><ComboBox x:Name="CmbDiscountType" Height="42" Foreground="{DynamicResource TextDark}" BorderBrush="{DynamicResource TagitBorder}" Background="{DynamicResource InputSurface}"><ComboBoxItem Content="percentage"/><ComboBoxItem Content="fixed"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="DISCOUNT VALUE" Style="{StaticResource FilterLabel}"/><TextBox x:Name="TxtDiscountValue" Style="{StaticResource LoginInput}" Tag="0.00"/></StackPanel>
            </Grid>

            <TextBlock Text="EXPIRES ON (optional)" Style="{StaticResource FilterLabel}"/>
            <TextBox x:Name="TxtValidUntil" Style="{StaticResource LoginInput}" Tag="2026-12-31" Margin="0,0,0,22"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Height="42" Width="100" Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnSave" Content="Create Coupon" Style="{StaticResource PrimaryButton}" Height="42" Width="140" Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
